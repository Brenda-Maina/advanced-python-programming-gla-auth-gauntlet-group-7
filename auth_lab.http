Content-Type: application/json

{
    "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoicmVmcmVzaCIsImV4cCI6MTc5MDI3MzM5MSwiaWF0IjoxNzkwMTg2OTkxLCJqdGkiOiJjNjNjNmNhZDIyMGE0N2RiYTExYzViNjhkZDg5NTU1NyIsInVzZXJfaWQiOiIxIn0.oWeXYwCtsh3TulG7z6G52_444b8_wBTiqZdpQmdIfPs"
